; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="2D-Platformer-Template"
run/main_scene="uid://7v5td2cnanp8"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

ConnectionValidator="*res://autoload/ConnectionValidator.gd"
Events="*res://autoload/Events.gd"
HitStopManager="*res://autoload/HitStopManager.gd"
InputRouter="*res://autoload/InputRouter.gd"
RespawnMemory="*res://autoload/RespawnMemory.gd"
Stats="*res://autoload/Stats.gd"
StatsHud="*res://autoload/StatsHud.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[gui]

theme/custom="res://art/fonts/DefaultTheme.tres"
theme/custom_font="res://art/fonts/Cubic_11.woff2"

